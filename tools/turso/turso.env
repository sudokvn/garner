# Where the Turso library in garnerd comes from. garnerd embeds Turso's
# prebuilt native library for Linux x86 with musl from the Go module
# github.com/tursodatabase/turso-go-platform-libs. That module carries the
# compiled library only; these pins name the Turso source it was built
# from and how, so the source archive can carry that source.
#
# Upstream states the mapping, it is not a reproducible-build attestation:
# the platform module's commit says it holds the libraries built from the
# Turso tag below, the embedded library matches the module's checksum, and
# the Rust version matches the paths compiled into the library. Update
# every value together when go.mod moves to another tursogo version, and
# review tools/turso/NOTICES.txt for that binary. tools/notices and
# tools/source.sh fail while go.mod and these pins disagree.
#
# The file is read by bash and by tools/notices: KEY=value lines only.

# The Go modules in go.mod.
TURSOGO_VERSION=v0.8.1
PLATFORM_LIBS_VERSION=v0.8.1
# The platform module's commit "Update prebuilt libs for ref: v0.8.1".
PLATFORM_LIBS_COMMIT=a30ababb15c2ddd5b99e61456ba774428ad88e63
# libs/linux_amd64_musl/libturso_sync_sdk_kit.so in the platform module.
LIBRARY=libs/linux_amd64_musl/libturso_sync_sdk_kit.so
LIBRARY_SHA256=d36ed759ae7ed58971166b8c3700d9ba67e63430130adefdb6ca31fb7c5e7cdc

# Turso's tag v0.8.1 is this commit. GitHub's archive of it and its
# Cargo.lock, which pins every Rust dependency.
TURSO_VERSION=v0.8.1
TURSO_COMMIT=8549c16595d2faf1bdd6ee24aee0be8bfabb3d4a
TURSO_ARCHIVE_URL=https://codeload.github.com/tursodatabase/turso/tar.gz/8549c16595d2faf1bdd6ee24aee0be8bfabb3d4a
TURSO_ARCHIVE_SHA256=dd0829b6c14c02ec63ba3b00f53104f3e6402a9a3022a3adc42e329a82994aa9
TURSO_CARGO_LOCK_SHA256=55f187e3aea044cbd5571c61a03d3f15a99ece0688e0749f13af32a8687b28f4

# How the platform module's build_libs.sh builds the library on Alpine.
# Turso's rust-toolchain.toml asks for Rust 1.88, which was 1.88.0.
RUST_VERSION=1.88.0
# rust-lang/rust at 1.88.0, used to review the standard library notices.
RUST_COMMIT=6b00bc3880198600130e1cf62b8f8a93494488cc
RUST_IMAGE=docker.io/library/rust:1.88.0-alpine3.22@sha256:9dfaae478ecd298b6b5a039e1f2cc4fc040fc818a2de9aa78fa714dea036574d
CARGO_PACKAGE=turso_sync_sdk_kit
CARGO_PROFILE=lib-release
RUST_TARGET=x86_64-unknown-linux-musl
RUSTFLAGS="-C target-feature=-crt-static"
